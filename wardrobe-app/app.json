{
  "expo": {
    "name": "Gardırop AI",
    "slug": "wardrobe-ai",
    "scheme": "wardrobeai",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAF8F5"
    },
    "ios": {
      "bundleIdentifier": "com.wardrobeai.app",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false,
        "CFBundleAllowMixedLocalizations": true
      }
    },
    "android": {
      "package": "com.wardrobeai.app",
      "adaptiveIcon": {
        "backgroundColor": "#FAF8F5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "blockedPermissions": ["android.permission.RECORD_AUDIO"],
      "predictiveBackGestureEnabled": false
    },
    "locales": {
      "en": "./locales/en.json",
      "tr": "./locales/tr.json"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      ["expo-router", { "asyncRoutes": false }],
      "expo-sqlite",
      "expo-secure-store",
      "expo-localization",
      "expo-sharing",
      [
        "expo-image-picker",
        {
          "photosPermission": "Gardırop AI, kıyafetlerini ve ilham aldığın kombinleri eklemen için fotoğraflarına erişir. / Wardrobe AI uses your photos so you can add clothes and outfit inspiration.",
          "cameraPermission": "Gardırop AI, kıyafetlerinin ve etiketlerinin fotoğrafını çekmen için kamerayı kullanır. / Wardrobe AI uses the camera so you can photograph clothes and care labels.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
